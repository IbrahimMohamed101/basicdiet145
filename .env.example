NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/basicdiet145

JWT_SECRET=replace-with-local-dev-secret
JWT_ACCESS_SECRET=replace-with-local-app-access-secret
DASHBOARD_JWT_SECRET=replace-with-local-dashboard-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=60
REFRESH_TOKEN_HASH_SECRET=replace-with-local-refresh-token-hash-secret
BCRYPT_ROUNDS=10

APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=false

OTP_TTL_MINUTES=5
OTP_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
AUTH_OTP_ENABLED=true
AUTH_PASSWORD_LOGIN_ENABLED=true
AUTH_EMAIL_OTP_ENABLED=false
OTP_TEST_MODE=false
ALLOW_TEST_AUTH=false
OTP_TEST_PHONE=
OTP_TEST_CODE=
OTP_HASH_SECRET=replace-with-local-otp-secret
EMAIL_OTP_HASH_SECRET=replace-with-separate-email-otp-secret
EMAIL_OTP_TTL_MINUTES=5
EMAIL_OTP_RESEND_SECONDS=60
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_RESET_TOKEN_TTL_MINUTES=10
EMAIL_OTP_TEST_MODE=false
EMAIL_OTP_TEST_EMAIL=
EMAIL_OTP_TEST_CODE=
RATE_LIMIT_OTP_WINDOW_MS=60000
RATE_LIMIT_OTP_MAX=5
RATE_LIMIT_OTP_VERIFY_WINDOW_MS=60000
RATE_LIMIT_OTP_VERIFY_MAX=10
RATE_LIMIT_MOBILE_LOGIN_WINDOW_MS=900000
RATE_LIMIT_MOBILE_LOGIN_MAX=20
RATE_LIMIT_DASHBOARD_LOGIN_WINDOW_MS=900000
RATE_LIMIT_DASHBOARD_LOGIN_MAX=20
RATE_LIMIT_CHECKOUT_WINDOW_MS=300000
RATE_LIMIT_CHECKOUT_MAX=20
RATE_LIMIT_ACCOUNT_DELETION_WINDOW_MS=900000
RATE_LIMIT_ACCOUNT_DELETION_MAX=5

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_WHATSAPP_FROM=

# Gmail OTP delivery. gmail_api uses HTTPS and works on Railway Hobby.
EMAIL_DELIVERY_PROVIDER=gmail_api
GMAIL_USER=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
# Optional SMTP fallback. Not used when EMAIL_DELIVERY_PROVIDER=gmail_api.
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Basic Diet
EMAIL_GMAIL_API_TIMEOUT_MS=30000
EMAIL_SMTP_CONNECTION_TIMEOUT_MS=10000
EMAIL_SMTP_GREETING_TIMEOUT_MS=10000
EMAIL_SMTP_SOCKET_TIMEOUT_MS=15000

# Subscription stacking is disabled unless the rollout flags below are enabled.
# Production additionally requires the explicit confirmation flag; keep it false
# until the certified mobile application version is live.
SUBSCRIPTION_STACKING_SHADOW_ENABLED=false
SUBSCRIPTION_STACKING_READ_ENABLED=false
SUBSCRIPTION_STACKING_WRITE_ENABLED=false
SUBSCRIPTION_STACKING_ALLOW_ALL_USERS=false
SUBSCRIPTION_STACKING_EXTRA_ACTIVATION_ENABLED=false
SUBSCRIPTION_STACKING_EXTRA_SELECTION_ENABLED=false
SUBSCRIPTION_STACKING_PRODUCTION_CONFIRMED=false

MOYASAR_API_KEY=
MOYASAR_SECRET_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=basicdiet145/menu

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
